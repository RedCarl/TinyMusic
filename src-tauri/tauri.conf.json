{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinyMusic",
  "version": "0.6.2",
  "identifier": "com.tinymusic.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TinyMusic",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data:; media-src 'self' http://127.0.0.1:* https: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "TinyMusic",
    "copyright": "Copyright © 2026 TinyMusic"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RedCarl/TinyMusic/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQzc5QTUyNzFDQ0E3QUIKUldTcnA4eHhVcHJIUXAxVXBGcEM5SW1zUENiZDRNcy8ycnpaWFI5OTZINmxkUTIwUGpCc3Rrd2wK"
    }
  }
}
